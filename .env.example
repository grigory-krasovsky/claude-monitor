# Образ (на VPS подставляется деплоем из GitHub Actions)
IMAGE=ghcr.io/OWNER/claude-usage-monitor:latest

# --- PostgreSQL ---
# Пароль пользователя monitor. Задаётся до первого запуска: Postgres читает его
# только при инициализации volume.
POSTGRES_PASSWORD=

# --- Шифрование токенов ---
# Ключ AES-256, которым зашифрованы OAuth-токены в базе: base64 от ровно 32 случайных байт.
# Обязателен — без него (или с неверным ключом) приложение не стартует. Сгенерировать:
#   openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# ВНИМАНИЕ: потеря или смена ключа = все сохранённые токены перестают читаться, и каждому
# пользователю придётся заново прислать /token. Храните ключ отдельно от бэкапов базы.
TOKEN_ENCRYPTION_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:AA...

# --- Импорт из однопользовательской версии (всё необязательно) ---
# Аккаунты, их токены и id сообщений теперь живут в PostgreSQL, а подключаются через
# /register и /token в личке с ботом. Переменные ниже нужны только для однократного
# переноса прежнего владельца: при первом старте его chat id заводится в базе как
# одобренный пользователь с этими токенами (файлы /data/tokens.json и /data/board.json
# свежее окружения). Дальше база — источник правды, и переменные можно удалить.
TELEGRAM_CHAT_ID=
# Refresh token (sk-ant-ort01-...) из ОТДЕЛЬНОГО логина:
#   CLAUDE_CONFIG_DIR=~/.claude-monitor claude login
# и затем claudeAiOauth.refreshToken из ~/.claude-monitor/.credentials.json.
# Отдельный каталог нужен потому, что бот ротирует refresh token при каждом обмене —
# копия из основного ~/.claude разлогинила бы локальный Claude Code.
# Токен из `claude setup-token` НЕ подходит: у него только scope user:inference,
# и /api/oauth/usage отвечает 403 «OAuth token does not meet scope requirement user:profile».
ANTHROPIC_REFRESH_TOKEN=
ANTHROPIC_ACCESS_TOKEN=

# --- Поведение (всё необязательно) ---
# Интервал опроса. Меньше 3m ставить нельзя: это TTL эндпоинта Anthropic.
POLL_INTERVAL=3m
# Как часто перерисовывается статусное сообщение из последнего среза данных.
RENDER_INTERVAL=15s
THRESHOLDS=50,75,90,95
TIMEZONE=Europe/Moscow

# Необязательный HTTP-прокси для исходящих запросов.
# Нужен, если из сети контейнера api.anthropic.com отдаёт 403 (гео-блокировка)
# или недоступен api.telegram.org.
HTTPS_PROXY=
