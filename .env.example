# Образ (на VPS подставляется деплоем из GitHub Actions)
IMAGE=ghcr.io/OWNER/claude-usage-monitor:latest

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:AA...
# ID чата для алертов. Как узнать — см. README, раздел «Где взять chat id».
TELEGRAM_CHAT_ID=

# --- Anthropic ---
# Долгоживущий токен из `claude setup-token` (живёт около года) — рекомендуемый вариант.
ANTHROPIC_ACCESS_TOKEN=sk-ant-oat01-...
# Необязательно: refresh token из ~/.claude/.credentials.json.
# Если задан, монитор сам обновляет access token и сохраняет ротацию в /data/tokens.json.
# ВНИМАНИЕ: Anthropic ротирует refresh token при обмене, поэтому копия на VPS
# может разлогинить локальный Claude Code. Используйте только если понимаете риск.
ANTHROPIC_REFRESH_TOKEN=

# --- Поведение (всё необязательно) ---
# Интервал опроса. Меньше 3m ставить нельзя: это TTL эндпоинта Anthropic.
POLL_INTERVAL=3m
THRESHOLDS=50,75,90,95
TIMEZONE=Europe/Moscow
NOTIFY_ON_START=true
NOTIFY_ON_RESET=true

# Необязательный HTTP-прокси для исходящих запросов.
# Нужен, если из сети контейнера api.anthropic.com отдаёт 403 (гео-блокировка)
# или недоступен api.telegram.org.
HTTPS_PROXY=
